{
  "name": "server-manager",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node index.js",
    "build": "node make.js && ng build",
    "clean": "rimraf ./dist",
    "watch": "ng build --watch --configuration development",
    "pretty": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\"",
    "build-deploy": "npm run clean && node make.js && ng build --base-href /server-manager/ && node postbuild.js",
    "copy-404": "cp dist/server-manager/index.html dist/server-manager/404.html",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/localize": "^19.2.0",
    "@angular/material": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "body-parser": "^1.20.3",
    "bootstrap": "^4.6.2",
    "cors": "^2.8.5",
    "discord.js": "^12.5.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-server": "^14.1.1",
    "make-cert": "^1.2.1",
    "moment": "^2.30.1",
    "openssl": "^2.0.0",
    "request": "^2.88.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "web-push": "^3.6.7",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.5.2",
    "typescript": "~5.8.2"
  }
}
